# Copy this file to .env (same folder as spotify-2016.exe) and fill in your values.
# Create a free app at https://developer.spotify.com/dashboard
# and add the REDIRECT_URI below to its Redirect URIs list.

CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=http://127.0.0.1:8888/callback
SECRET_KEY=generate with and paste output "python -c "import secrets; print(secrets.token_hex(32))"
"
